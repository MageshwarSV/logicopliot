{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteAndReadOwnBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:PutObjectRetention", "s3:GetObject", "s3:GetObjectAttributes"],
      "Resource": "arn:aws:s3:::YOUR-BUCKET/sit/*"
    },
    {
      "Sid": "ListOwnFolder",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR-BUCKET",
      "Condition": {"StringLike": {"s3:prefix": ["sit/*"]}}
    }
  ]
}
