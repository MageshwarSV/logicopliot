# /etc/cargora-backup.env  (chmod 600, owner root) - copy this file, fill it in on the server.
# Never commit the real file.

# prod on cargora-db  |  sit on the SIT server
ENV_NAME=prod
# prod: cargora   |  sit: logicopilot
DB_NAME=cargora

S3_BUCKET=your-bucket-name
# prod: prod      |  sit: sit
S3_PREFIX=prod

# prod: 35 and 365 |  sit: 7 and 0 (no monthly copy)
DAILY_DAYS=35
MONTHLY_DAYS=365

KEEP_LOCAL=3
LOCAL_DIR=/var/backups/cargora
AWS_PROFILE_NAME=cargora-backup

# Where the app reads "last backup" (Application Health).
# prod (cargora-db): redis://:REDIS_PASSWORD@127.0.0.1:6379/0   (password: /root/cargora-secrets/redis_password)
# sit:               redis://127.0.0.1:6379/4
REDIS_URL=
